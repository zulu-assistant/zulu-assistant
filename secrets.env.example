# Zulu Assistant secrets — copy to data/secrets.env (gitignored) and chmod 600.
# Read by src/config.mjs loadSecrets() (re-read when the file changes; no restart).
# A missing key switches that feature off quietly — nothing else breaks.

# Alert email (escalation tier 1 + the daily fleet briefing) — STARTTLS SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=
ALERT_EMAIL_TO=you@example.com

# Critical-tier SMS (tier 2): POST {to, message} to your SMS webhook with
# header x-internal-key: SMS_WEBHOOK_KEY. Comma-separate several recipients.
SMS_WEBHOOK_URL=https://sms.example.com/api/sms
SMS_WEBHOOK_KEY=
SMS_ALERT_TO=+15555550100

# Dead-man heartbeat: the board PATCHes {beat_at, host} to this PostgREST row
# every 60s; a GitHub Action alerts when it goes quiet (.github/workflows/deadman.example.yml — rename it to deadman.yml to enable).
HEARTBEAT_URL=https://<project-ref>.supabase.co/rest/v1/ops_heartbeat?id=eq.1
HEARTBEAT_KEY=
HEARTBEAT_HOST=my-mac

# Only for `scripts/bootstrap.sh install --deadman`, which pushes these to GitHub
# Actions secrets for deadman.yml: the workflow READS the heartbeat row with a
# read-only key and emails via SMTP_* to ALERT_EMAIL_TO.
HEARTBEAT_READ_URL=https://<project-ref>.supabase.co/rest/v1/ops_heartbeat?select=beat_at,host&id=eq.1
HEARTBEAT_READ_KEY=
