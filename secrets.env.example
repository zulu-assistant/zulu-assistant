# Zulu Assistant secrets — copy to data/secrets.env (gitignored) and chmod 600.
# Read by src/config.mjs loadSecrets() (re-read when the file changes; no restart).
# A missing or empty key switches that feature off quietly — nothing else breaks.
# Every value below starts EMPTY on purpose: an example address left in a real key
# would read as a channel that is set up. The examples are in the comments.

# Alert email (escalation tier 1 + the daily fleet briefing) — STARTTLS SMTP
#   SMTP_HOST e.g. smtp.example.com      SMTP_USER e.g. alerts@example.com
#   ALERT_EMAIL_TO e.g. you@example.com  (empty = sent to SMTP_USER)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# Critical-tier SMS (tier 2): POST {to, message} to your SMS webhook with
# header x-internal-key: SMS_WEBHOOK_KEY. Comma-separate several recipients.
#   SMS_WEBHOOK_URL e.g. https://sms.example.com/api/sms   SMS_ALERT_TO e.g. +15555550100
SMS_WEBHOOK_URL=
SMS_WEBHOOK_KEY=
SMS_ALERT_TO=

# Dead-man heartbeat: the board PATCHes {beat_at, host} to this PostgREST row
# every 60s; a GitHub Action alerts when it goes quiet (.github/workflows/deadman.example.yml — rename it to deadman.yml to enable).
#   HEARTBEAT_URL e.g. https://<project-ref>.supabase.co/rest/v1/ops_heartbeat?id=eq.1
#   HEARTBEAT_HOST e.g. my-mac  (empty = this machine's host name)
HEARTBEAT_URL=
HEARTBEAT_KEY=
HEARTBEAT_HOST=

# Only for `scripts/bootstrap.sh install --deadman`, which pushes these to GitHub
# Actions secrets for deadman.yml: the workflow READS the heartbeat row with a
# read-only key and emails via SMTP_* to ALERT_EMAIL_TO.
#   HEARTBEAT_READ_URL e.g. https://<project-ref>.supabase.co/rest/v1/ops_heartbeat?select=beat_at,host&id=eq.1
HEARTBEAT_READ_URL=
HEARTBEAT_READ_KEY=

# Chat intake (scripts/chat-intake.mjs, task #223) — Slack app in Socket Mode.
# App-level token (Basic Information → App-Level Tokens, scope connections:write)
# and the bot token (Install to Workspace). Empty = intake off (idles).
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=

# Push approvals (src/relay.mjs, docs/RELAY.md): the WRITE token of your self-hosted ntfy server
# (`ntfy token add <user>`). Not needed for the public ntfy.sh fallback. Empty + relay on = observe only.
RELAY_TOKEN=
