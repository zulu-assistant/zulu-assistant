{
  "_metadata": { "major_version": 1, "minor_version": 1 },
  "display_information": {
    "name": "Zulu Intake",
    "description": "Turns team requests into tasks for your Zulu Assistant agents. Approvals never happen in chat.",
    "background_color": "#0a0f0a"
  },
  "features": {
    "bot_user": { "display_name": "zulu", "always_online": true }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "chat:write",
        "files:read",
        "files:write",
        "groups:history",
        "groups:read",
        "reactions:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_mention", "message.channels", "message.groups"]
    },
    "interactivity": { "is_enabled": false },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
