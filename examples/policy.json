{
  "_doc": "Guardrails policy (docs/GUARDRAILS.md). Gated tool calls wait for the owner on the ledger and run once on approval. mode: enforce | observe (log only) | off. enforceFor: agent names, or * for all. standing: true = a program go on the task approves this class without a per-action tap (docs/GUARDRAILS.md). lists: owner-specific names the rules refer to with @name. checks: what else the classifier reads, each off | observe | enforce (observe = the call passes and the reading says it would be held; a missing key means observe).",
  "version": 1,
  "mode": "enforce",
  "enforceFor": [
    "*"
  ],
  "defaults": {
    "ttlMinutes": 120,
    "approver": "owner",
    "requireDryRun": false
  },
  "checks": {
    "inlineBodies": "observe",
    "renamedBins": "observe",
    "selfProtect": "observe"
  },
  "classes": [
    {
      "id": "merge",
      "label": "Merge a pull request",
      "standing": true,
      "rules": [
        {
          "bin": "gh",
          "args": [
            "pr",
            "merge"
          ]
        }
      ]
    },
    {
      "id": "push",
      "label": "Push to a protected branch or public remote, force-push, push tags or delete a ref",
      "rules": [
        {
          "bin": "git",
          "args": [
            "push"
          ],
          "when": "pushProtected",
          "protectedRefs": [
            "main",
            "master"
          ],
          "allowRefs": [
            "checkpoint/*"
          ]
        }
      ]
    },
    {
      "id": "deploy",
      "label": "Deploy to production, or touch a paid/outbound job",
      "rules": [
        {
          "bin": "vercel",
          "notArgs": [
            [
              "env",
              "ls"
            ],
            [
              "ls"
            ],
            [
              "whoami"
            ],
            [
              "logs"
            ],
            [
              "inspect"
            ],
            [
              "list"
            ]
          ]
        },
        {
          "bin": "launchctl",
          "argsAny": [
            "bootstrap",
            "bootout",
            "load",
            "unload",
            "enable",
            "disable",
            "kickstart"
          ],
          "labels": "@paidOrOutbound"
        },
        {
          "bin": "shopify",
          "argsAny": [
            "deploy",
            "push",
            "publish"
          ]
        }
      ]
    },
    {
      "id": "deploy-local",
      "label": "Load or unload a service on this machine",
      "standing": true,
      "rules": [
        {
          "bin": "launchctl",
          "argsAny": [
            "bootstrap",
            "bootout",
            "load",
            "unload",
            "enable",
            "disable"
          ],
          "unlessLabels": "@paidOrOutbound"
        }
      ]
    },
    {
      "id": "upgrade",
      "label": "Upgrade or roll back this install",
      "rules": [
        { "bin": "zulu", "args": ["upgrade"], "unlessFlags": ["--check"] },
        { "bin": "zulu", "args": ["rollback"] },
        { "scriptIn": ["**/upgrade.mjs"], "unlessFlags": ["--check"] },
        { "scriptIn": ["**/install.sh"], "args": ["upgrade"], "unlessFlags": ["--check"] },
        { "scriptIn": ["**/install.sh"], "args": ["rollback"] }
      ]
    },
    {
      "id": "env",
      "label": "Change production configuration or secrets",
      "rules": [
        {
          "bin": "gh",
          "args": [
            "secret"
          ],
          "argsAny": [
            "set",
            "delete"
          ]
        },
        {
          "bin": "gh",
          "args": [
            "variable"
          ],
          "argsAny": [
            "set",
            "delete"
          ]
        }
      ]
    },
    {
      "id": "guarded",
      "label": "Run a script on the guarded list (it writes without a flag)",
      "rules": [
        {
          "scriptIn": "@guardedScripts",
          "unlessFlags": "@dryFlags"
        }
      ]
    },
    {
      "id": "write",
      "label": "A guarded script's write form",
      "requireDryRun": true,
      "rules": [
        {
          "script": true,
          "flagsAny": [
            "--commit",
            "--apply",
            "--write",
            "--execute",
            "--confirm",
            "--activate",
            "--live",
            "--send",
            "--go"
          ]
        }
      ]
    },
    {
      "id": "outbound",
      "label": "Send a message or post outside the system",
      "rules": [
        {
          "bin": "curl",
          "method": "POST",
          "urlAny": [
            "slack.com/api/chat.",
            "slack.com/api/files.",
            "api.twilio.com",
            "a.klaviyo.com/api/campaign-send"
          ]
        },
        {
          "tool": "^mcp__.*__(send_message|reply|forward)$"
        }
      ]
    },
    {
      "id": "store",
      "label": "Write to the store through an MCP tool",
      "rules": [
        {
          "tool": "^mcp__.*Shopify__(graphql_mutation|create-.*|update-.*|set-inventory|bulk-.*|add-to-collection|publish-.*|upload-.*)$"
        }
      ]
    },
    {
      "id": "delete",
      "label": "Delete outside the working tree, drop data, delete repos",
      "rules": [
        {
          "bin": "rm",
          "flagsAny": [
            "-r",
            "-R",
            "--recursive"
          ],
          "when": "outsideRepo"
        },
        {
          "bin": "find",
          "flagsAny": [
            "-delete",
            "-exec",
            "-execdir",
            "-ok",
            "-okdir"
          ],
          "when": "outsideRepo"
        },
        {
          "sql": "\\b(drop|truncate)\\s+(table|schema|database)\\b"
        },
        {
          "bin": "gh",
          "args": [
            "repo",
            "delete"
          ]
        },
        { "bin": "git", "args": ["clean"], "flagsAny": ["-x", "-X"], "unlessFlags": ["-n", "--dry-run"], "check": "selfProtect" }
      ]
    },
    {
      "id": "schedule",
      "label": "Change scheduled jobs",
      "rules": [
        {
          "bin": "crontab",
          "unlessFlags": [
            "-l"
          ]
        },
        {
          "pathWrite": "~/Library/LaunchAgents/**"
        }
      ]
    },
    {
      "id": "self",
      "label": "Change or read the gate itself",
      "rules": [
        {
          "pathAny": [
            "@guardSecrets"
          ]
        },
        {
          "pathWrite": "@guardConfig"
        },
        {
          "textAny": [
            "gate_decide",
            "x-mesh-decision"
          ]
        },
        {
          "scriptIn": [
            "**/task.sh"
          ],
          "args": [
            "gate"
          ]
        },
        {
          "scriptIn": [
            "**/mesh-cli.mjs"
          ],
          "args": [
            "task",
            "gate"
          ]
        },
        {
          "scriptIn": [
            "**/task.sh"
          ],
          "flagsAny": [
            "--signed"
          ]
        },
        {
          "scriptIn": [
            "**/agent-send.sh"
          ],
          "flagsAny": [
            "--signed"
          ]
        },
        {
          "scriptIn": [
            "**/mesh-cli.mjs"
          ],
          "flagsAny": [
            "--signed"
          ]
        },
        { "scriptIn": ["**/install.sh"], "flagsAny": ["--guardrails"], "unlessFlags": ["--dry-run"] },
        { "scriptIn": ["**/install.sh"], "args": ["guardrails"], "unlessFlags": ["--dry-run"] },
        { "bin": "zulu", "flagsAny": ["--guardrails"], "unlessFlags": ["--dry-run"] },
        { "bin": "zulu", "args": ["guardrails"], "unlessFlags": ["--dry-run"] },
        { "pathGuard": ["@gateCode", "@guardGate"], "check": "selfProtect" },
        { "bin": "git", "args": ["config"], "mentions": ["core.", "alias.", "--global", "--system", "--file", "-f", "--edit", "-e", "remote.", "url.", "branch.", "include", "filter.", "diff.", "merge.", "pager.", "credential.", "http.", "protocol.", "submodule.", "gpg.", "sequence.", "interactive.", "uploadpack.", "receive.", "fetch.", "pull.", "init.", "safe.", "extensions."], "when": "gitConfigWrite", "check": "selfProtect" },
        { "bin": "git", "mentions": ["core.hookspath=", "alias."], "when": "gitDashC", "check": "selfProtect" },
        { "bin": "git", "argsAny": ["update-ref", "symbolic-ref", "fetch", "push"], "mentions": ["refs/remotes/", "refs/heads/main", "refs/heads/master", "refs/heads/origin/", "refs/tags/origin/", "refs/replace/"], "when": "gitRefWrite", "check": "selfProtect" },
        { "bin": "git", "args": ["remote"], "argsAny": ["set-url", "add", "rename", "remove", "rm", "set-head", "set-branches"], "check": "selfProtect" },
        { "bin": "git", "argsAny": ["pull", "merge", "rebase", "cherry-pick", "revert", "apply", "am", "checkout", "switch", "reset", "stash", "restore", "branch", "rm", "mv", "read-tree", "bisect", "fetch", "tag", "update-ref", "symbolic-ref", "update-index", "checkout-index", "clean", "submodule", "replace"], "when": "liveCheckout", "check": "selfProtect" },
        { "bin": "kill", "when": "boardProcess", "check": "selfProtect" },
        { "bin": "pkill", "when": "boardProcess", "check": "selfProtect" },
        { "bin": "killall", "when": "boardProcess", "check": "selfProtect" },
        { "bin": "xargs", "argsAny": ["kill"], "when": "boardProcess", "check": "selfProtect" },
        { "bin": "launchctl", "argsAny": ["kill", "stop", "remove", "reboot"], "when": "boardProcess", "check": "selfProtect" },
        { "bin": "fuser", "when": "boardProcess", "check": "selfProtect" },
        { "bin": "kill-port", "when": "boardProcess", "check": "selfProtect" },
        { "bin": "reboot", "when": "boardProcess", "check": "selfProtect" },
        { "bin": "shutdown", "when": "boardProcess", "check": "selfProtect" },
        { "bin": "halt", "when": "boardProcess", "check": "selfProtect" },
        { "bin": "poweroff", "when": "boardProcess", "check": "selfProtect" },
        { "bin": "osascript", "mentions": ["restart", "shut down", "shutdown", "log out", "logout"], "when": "boardProcess", "check": "selfProtect" }
      ]
    }
  ],
  "lists": {
    "paidOrOutbound": [],
    "publicRemotes": [],
    "deployOnPush": [],
    "guardedScripts": [],
    "dryFlags": [
      "--dry-run",
      "-n",
      "--check",
      "--plan"
    ],
    "guardSecrets": [
      "<repo>/data/guardrails/**",
      "<repo>/data/mesh-decision-token"
    ],
    "guardConfig": [
      "<repo>/overlay/policy.json",
      "<repo>/policy.json",
      "<repo>/examples/policy.json",
      "~/.claude/settings.json",
      "~/.codex/hooks.json"
    ],
    "gateCode": [
      "<live>/scripts/gate-hook.sh",
      "<live>/scripts/gate-hook.mjs",
      "<live>/scripts/gate-triggers.default",
      "<live>/scripts/guardrails-install.sh",
      "<live>/scripts/merge-hooks.mjs",
      "<live>/scripts/env.sh",
      "<live>/src/gates.mjs",
      "<live>/src/gate-service.mjs",
      "<live>/src/gate-ledger.mjs",
      "<live>/src/request-guard.mjs",
      "<live>/src/guard.mjs",
      "<live>/src/caller.mjs",
      "<live>/src/tasks.mjs",
      "<live>/src/config.mjs",
      "<live>/server.mjs",
      "<live>/public/**",
      "<live>/src/gate-integrity.mjs",
      "<live>/scripts/gate-config-hook.sh",
      "<live>/scripts/gate-config-hook.mjs"
    ],
    "guardGate": [
      "<live>/overlay/config/agents.json",
      "<live>/config/agents.json",
      "<live>/data/local.env",
      "<live>/data/tasks/**",
      "**/.claude/settings.json",
      "**/.claude/settings.local.json",
      "~/.claude.json",
      "~/.codex/config.toml",
      "**/.codex/hooks.json",
      "/Library/Application Support/ClaudeCode/**",
      "/etc/codex/**",
      "~/.zshrc",
      "~/.zshenv",
      "~/.zprofile",
      "~/.zlogin",
      "~/.bashrc",
      "~/.bash_profile",
      "~/.profile",
      "~/.gitconfig",
      "**/.git/hooks/**",
      "**/.git/config",
      "<live>/.git/HEAD",
      "<live>/.git/index",
      "<live>/.git/refs/**",
      "<live>/.git/packed-refs",
      "<live>/.git/info/**",
      "<live>/.gitattributes",
      "~/.config/cmux/**",
      "~/.cmuxterm/claude-hook-sessions.json",
      "~/.cmuxterm/codex-hook-sessions.json"
    ]
  }
}
