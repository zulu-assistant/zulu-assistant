<?xml version="1.0" encoding="UTF-8"?>
<!-- Push-approval relay (#415, docs/RELAY.md): a self-hosted ntfy server for the owner's phone.
     NOT installed by bootstrap.sh. Render with scripts/render-tmpl.sh; loading it is a gated
     deploy-local (the owner's tap). Config: data/relay/server.yml (from examples/relay/server.yml). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__LABEL_PREFIX__.ntfy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>ntfy</string>
    <string>serve</string>
    <string>--config</string>
    <string>__REPO__/data/relay/server.yml</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__REPO__/logs/ntfy.log</string>
  <key>StandardErrPath</key><string>__REPO__/logs/ntfy.err.log</string>
  <key>WorkingDirectory</key><string>__REPO__</string>
</dict>
</plist>
